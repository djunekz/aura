{
  "name": "aura-terminal",
  "version": "0.11.0",
  "description": "Adaptive Unified Runtime Assistant (mini OS-layer) — CLI automation for Termux",
  "author": "djunekz",
  "license": "MIT",
  "type": "module",
  "main": "./aura.js",
  "exports": {
    ".": "./aura.js"
  },
  "bin": {
    "aura": "aura.js"
  },
  "files": [
    "aura.js",
    "core/",
    "marketplace/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node aura.js",
    "test": "node --test",
    "lint": "eslint .",
    "validate:marketplace": "node scripts/validate-marketplace.js",
    "check": "npm run lint && npm test && npm run validate:marketplace",
    "version": "node scripts/changelog.js promote && git add CHANGELOG.md",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "terminal",
    "assistant",
    "os-layer",
    "automation",
    "termux",
    "tui",
    "git",
    "scheduler",
    "plugins",
    "workflow"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djunekz/aura.git"
  },
  "homepage": "https://github.com/djunekz/aura#readme",
  "bugs": {
    "url": "https://github.com/djunekz/aura/issues"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "chalk": "^6.0.1",
    "chokidar": "^4.0.3",
    "fuzzy": "^0.1.3",
    "is-online": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
