  "repository": {
    "type": "git",
    "url": "git+https://github.com/djunekz/aura.git"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "chalk": "^5.3.0",
    "chokidar": "^4.0.3",
    "form-data": "^4.0.0",
    "fs-extra": "^11.2.0",
    "fuzzy": "^0.1.3",
    "inquirer": "^12.3.0",
    "is-online": "^11.0.0",
    "xml2js": "^0.6.2"
  }
}
