{
  "name": "aura-terminal",
  "version": "0.8.0",
  "description": "Adaptive Unified Runtime Assistant (mini OS-Layer)",
  "author": "djunekz",
  "license": "MIT",
  "type": "module",
  "main": "./aura.js",
  "exports": {
    ".": "./aura.js"
  },
  "bin": {
    "aura": "aura.js"
  },
  "files": [
    "aura.js",
    "core/",
    "marketplace/",
